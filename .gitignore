# 构建产物（可由 build.py / build_virtual.py 重新生成，约 70MB）
build/
*.elf
*.bin
*.hex
*.map
*.list
*.o
*.d
*.su

# Python 缓存
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# 运行期数据产出（由 episode_recorder.py / export_lerobot.py 生成）
episodes/
dataset/
*-result.json

# 临时与备份
*.tmp
*.bak
*.log
_backup*/
*_backup*/

# 系统文件
Thumbs.db
desktop.ini
.DS_Store

# Hermes 计划文件（本地工作产物，不入库）
.hermes/
